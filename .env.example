# PhonePe Standard Checkout v2 — OAuth client credentials
# Get these from the PhonePe Business merchant dashboard.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# Environment: "sandbox" (default) or "production"
PHONEPE_ENV=sandbox

# Webhook credentials — required only if you call verify_webhook_signature.
# These are the username/password you configured for webhook delivery
# on the PhonePe merchant dashboard.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
